{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signpost.dev/schemas/receipt.schema.json",
  "title": "Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "request", "session", "status", "evidence", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^rec_[a-zA-Z0-9]+$"
    },
    "request": {
      "type": "string",
      "pattern": "^req_[a-zA-Z0-9]+$"
    },
    "session": {
      "type": "string",
      "pattern": "^sess_[a-zA-Z0-9]+$"
    },
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "cancelled"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
