{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signpost.dev/schemas/identity.schema.json",
  "title": "Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "owner", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$"
    },
    "kind": {
      "type": "string",
      "enum": ["human", "worker", "org", "team", "service", "gate"]
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "accepts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "gate": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)?$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "disabled"]
    },
    "is_admin": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
